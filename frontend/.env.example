# Convex (filled by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Local site URL for Convex Auth redirects
SITE_URL=http://localhost:3000

# AI provider selection is set on the Convex deployment (not Next.js):
#   npx convex env set AI_PROVIDER gemini   # or groq, or nvidia
#   npx convex env set GEMINI_API_KEY ...
#   npx convex env set GEMINI_MODEL gemini-2.5-flash-lite
#   npx convex env set GROQ_API_KEY ...
#   npx convex env set GROQ_MODEL llama-3.3-70b-versatile
#   npx convex env set NVIDIA_API_KEY ...
#   npx convex env set NVIDIA_MODEL z-ai/glm-5.2
# Preferred provider is tried first; the others are used as fallback, in order, if their keys are set.
