# Convex (filled by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Local site URL for Convex Auth redirects
SITE_URL=http://localhost:3000

# AI provider selection is set on the Convex deployment (not Next.js):
#   npx convex env set AI_PROVIDER nvidia   # or gemini
#   npx convex env set NVIDIA_API_KEY ...
#   npx convex env set GEMINI_API_KEY ...
#   npx convex env set NVIDIA_MODEL z-ai/glm-5.2
#   npx convex env set GEMINI_MODEL gemini-2.0-flash
# Preferred provider is tried first; the other is used as fallback if its key is set.
